        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum by (status) (rate(http_requests_total{instance=~\"$instance\",job=~\"$job\"}[5m]))",
            "legendFormat": "{{status}}",
            "refId": "A",
            "interval": "",
            "intervalFactor": 1
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
