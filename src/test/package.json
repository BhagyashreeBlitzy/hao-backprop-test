{
  "name": "nodejs-hello-world-tutorial-test",
  "version": "1.0.0",
  "description": "Test suite for Node.js/Express.js Hello World tutorial backend. Provides unit, integration, performance, and e2e tests with code coverage and robust environment setup.",
  "private": true,
  "scripts": {
    "test": "cross-env NODE_ENV=test jest --config=jest.config.js",
    "test:watch": "cross-env NODE_ENV=test jest --config=jest.config.js --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --config=jest.config.js --coverage",
    "test:unit": "cross-env NODE_ENV=test jest --config=jest.config.js --runTestsByPath unit",
    "test:integration": "cross-env NODE_ENV=test jest --config=jest.config.js --runTestsByPath integration",
    "test:performance": "cross-env NODE_ENV=test jest --config=jest.config.js --runTestsByPath performance",
    "test:e2e": "cross-env NODE_ENV=test jest --config=jest.config.js --runTestsByPath e2e",
    "test:ci": "cross-env NODE_ENV=test jest --config=jest.config.js --coverage --runInBand",
    "coverage:report": "node scripts/generate-coverage-report.js",
    "validate": "npm ls && npm audit"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "@babel/preset-env": "^7.24.0",
    "cross-env": "^7.0.3",
    "sinon": "^17.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {},
  "keywords": [
    "nodejs",
    "express",
    "tutorial",
    "test",
    "jest",
    "supertest",
    "babel"
  ],
  "author": "Tutorial Author",
  "license": "MIT"
}