{
  "name": "nodejs-hello-world-tutorial-test",
  "version": "1.0.0",
  "description": "Test suite for Node.js/Express.js Hello World tutorial backend. Provides unit, integration, performance, and e2e tests with code coverage and robust environment setup.",
  "private": true,
  "main": "jest.config.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test jest --config=jest.config.js",
    "test:watch": "cross-env NODE_ENV=test jest --config=jest.config.js --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --config=jest.config.js --coverage",
    "test:unit": "cross-env NODE_ENV=test jest --config=jest.config.js --testPathPattern=unit",
    "test:integration": "cross-env NODE_ENV=test jest --config=jest.config.js --testPathPattern=integration",
    "test:performance": "cross-env NODE_ENV=test jest --config=jest.config.js --testPathPattern=performance",
    "test:e2e": "cross-env NODE_ENV=test jest --config=jest.config.js --testPathPattern=e2e",
    "test:ci": "cross-env NODE_ENV=test jest --config=jest.config.js --coverage --runInBand --forceExit",
    "test:debug": "cross-env NODE_ENV=test DEBUG=* jest --config=jest.config.js --runInBand --detectOpenHandles",
    "coverage:report": "cross-env NODE_ENV=test jest --config=jest.config.js --coverage --coverageReporters=html",
    "coverage:text": "cross-env NODE_ENV=test jest --config=jest.config.js --coverage --coverageReporters=text",
    "validate": "npm ls && npm audit --audit-level=moderate",
    "clean": "rm -rf coverage && rm -rf node_modules/.cache",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write '**/*.js'",
    "format:check": "prettier --check '**/*.js'",
    "pretest": "npm run validate",
    "posttest": "npm run coverage:text"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "sinon": "^17.0.0",
    "supertest": "^7.1.1"
  },
  "dependencies": {},
  "peerDependencies": {
    "express": "5.1.0"
  },
  "keywords": [
    "nodejs",
    "express",
    "tutorial",
    "test",
    "jest",
    "supertest",
    "babel",
    "tdd",
    "bdd",
    "unit-testing",
    "integration-testing",
    "e2e-testing",
    "performance-testing",
    "code-coverage",
    "ci-cd",
    "testing-framework",
    "educational"
  ],
  "author": "Tutorial Author",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tutorial/nodejs-hello-world-tutorial.git",
    "directory": "src/test"
  },
  "bugs": {
    "url": "https://github.com/tutorial/nodejs-hello-world-tutorial/issues"
  },
  "homepage": "https://github.com/tutorial/nodejs-hello-world-tutorial#readme",
  "jest": {
    "preset": "./jest.config.js"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "18"
          }
        }
      ]
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "jest": true,
      "es6": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:jest/recommended",
      "plugin:node/recommended"
    ],
    "plugins": [
      "jest",
      "node"
    ],
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "jest/no-disabled-tests": "warn",
      "jest/no-focused-tests": "error",
      "jest/no-identical-title": "error",
      "jest/prefer-to-have-length": "warn",
      "jest/valid-expect": "error",
      "node/no-unpublished-require": "off"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false
  },
  "files": [
    "jest.config.js",
    "babel.config.js",
    "setup.js",
    "unit/",
    "integration/",
    "performance/",
    "e2e/",
    "helpers/"
  ],
  "directories": {
    "test": "."
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}