{
  "watch": [
    "app.js",
    "server.js",
    "routes/",
    "middleware/",
    "utils/",
    "config/",
    "healthcheck/"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules/",
    "test/",
    "coverage/",
    "scripts/",
    "*.test.js",
    "*.spec.js",
    "*.perf.js",
    "*.e2e.js"
  ],
  "exec": "node server.js",
  "env": {
    "NODE_ENV": "development",
    "PORT": "3000"
  },
  "delay": "100",
  "legacyWatch": false,
  "verbose": true
}