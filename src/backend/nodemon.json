{
  "watch": [
    "app.js",
    "server.js",
    "routes/",
    "middleware/",
    "utils/",
    "config/"
  ],
  "ext": "js,json",
  "ignore": [
    "test/",
    "node_modules/",
    "scripts/",
    "Dockerfile",
    "docker-compose.yml",
    "*.test.js",
    "*.spec.js"
  ],
  "exec": "node server.js",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": "100ms",
  "legacyWatch": false,
  "verbose": true
}