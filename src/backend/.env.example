# Example environment configuration for Node.js tutorial backend
# Copy this file to .env and modify values as needed for your local or deployment environment
# Do not commit your actual .env file to version control

# ======================
# Server Configuration
# ======================

# The port the server will listen on
# Default: 3000 (F-001-RQ-001: Server Port Binding requirement)
PORT=3000

# The host address for the server
# Default: localhost for local development
HOST=localhost

# ======================
# Environment Settings
# ======================

# Node environment (development, production, test)
# This affects Express.js behavior and error handling
# Default: development for local development
NODE_ENV=development

# ======================
# Logging Configuration
# ======================

# Logging level (error, warn, info, debug)
# Controls the verbosity of console output
# Default: info for balanced logging
LOG_LEVEL=info

# ======================
# Security Configuration
# ======================

# Disable Express.js fingerprinting header
# Set to true to remove X-Powered-By header for security
DISABLE_X_POWERED_BY=true

# ======================
# Application Settings
# ======================

# Application name for logging and monitoring
APP_NAME=nodejs-hello-tutorial

# Application version for tracking
APP_VERSION=1.0.0

# Maximum request timeout in milliseconds
# Default: 30000 (30 seconds)
REQUEST_TIMEOUT=30000

# ======================
# Development Settings
# ======================

# Enable development mode features
# Set to true for enhanced debugging and auto-reload
DEV_MODE=true

# Console color output
# Set to false to disable colored console output
CONSOLE_COLORS=true

# ======================
# Future Extensions
# ======================

# Database connection string (for future database integration)
# DATABASE_URL=

# Redis connection string (for future caching integration)
# REDIS_URL=

# JWT secret key (for future authentication integration)
# JWT_SECRET=

# External API endpoints (for future API integrations)
# EXTERNAL_API_BASE_URL=

# ======================
# Monitoring and Health
# ======================

# Enable health check endpoint
# Set to true to enable /health endpoint
HEALTH_CHECK_ENABLED=true

# Performance monitoring
# Set to true to enable basic performance metrics logging
PERFORMANCE_MONITORING=false

# ======================
# NOTES
# ======================
# 1. Copy this file to .env in the same directory
# 2. Modify values according to your local setup
# 3. Never commit .env files to version control
# 4. Add additional environment variables as needed for future features
# 5. Use NODE_ENV=production for production deployments
# 6. Ensure PORT is available and not in use by other services
# 7. LOG_LEVEL=debug provides verbose output for development