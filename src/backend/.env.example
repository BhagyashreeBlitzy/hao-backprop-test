# Example .env file for backend Node.js/Express.js application
# Copy this file to .env and adjust values as needed for your environment.

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================

# PORT: The port number the server will listen on. Default is 3000. Override in production/cloud environments.
# Platform-agnostic port assignment ensures compatibility with cloud hosting platforms
# such as Render, Heroku, Vercel, Railway, etc. that dynamically assign ports.
# For local development, the default port 3000 will be used.
# Production deployments should allow the hosting platform to set this via environment variables.
PORT=3000

# NODE_ENV: Node.js environment mode. Set to 'production' for production deployments.
# This environment variable is crucial for:
# - Enabling production optimizations in Express.js
# - Proper error handling and security posture
# - Framework-level performance enhancements
# - Security headers and error message filtering
# Valid values: 'development', 'production', 'test'
NODE_ENV=development

# ==============================================================================
# DEPLOYMENT NOTES
# ==============================================================================

# For Local Development:
# - Copy this file to .env
# - Keep NODE_ENV=development for detailed error messages and debugging
# - PORT=3000 provides a standard development port

# For Production Deployment:
# - Set NODE_ENV=production to enable security features and performance optimizations
# - Allow hosting platform to override PORT (do not set PORT in production .env)
# - Cloud platforms like Render, Heroku automatically provide PORT via process.env.PORT

# For Testing:
# - Set NODE_ENV=test for testing environment
# - Use PORT=0 to allow dynamic port assignment during testing

# ==============================================================================
# PLATFORM-SPECIFIC CONFIGURATION
# ==============================================================================

# The application is designed to work with:
# - Render: Automatically provides PORT via environment variables
# - Heroku: Uses process.env.PORT for dynamic port assignment  
# - Vercel: Serverless deployment with automatic port handling
# - Railway: Dynamic port assignment for web services
# - Local development: Falls back to PORT=3000 when not provided

# Security Best Practices:
# - Never commit actual .env files to version control
# - Use this .env.example as a template for required environment variables
# - Set NODE_ENV=production in production environments for security
# - Regularly update and validate environment configuration