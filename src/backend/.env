# ============================================================================
# Node.js Tutorial Application - Backend Environment Configuration
# ============================================================================
# This file contains environment variables for the Node.js tutorial application
# backend server. These variables are loaded into process.env at runtime using
# the dotenv package (v16.4.5) and provide configuration values that can be
# overridden without code changes.
#
# Usage: This file is read by dotenv at process startup and should be loaded
# in the main application entry point (e.g., server.js or app.js).
#
# Security Note: Do not commit sensitive values to version control. This file
# contains development defaults only. Use environment-specific configuration
# or secure secret management for production deployments.
# ============================================================================

# ----------------------------------------------------------------------------
# HTTP Server Configuration
# ----------------------------------------------------------------------------

# PORT: The port number for the HTTP server to bind to
# - Used by Express.js server.listen() method
# - Default: 3000 (standard development port for Node.js applications)
# - Valid range: 1024-65535 (avoid system reserved ports 1-1023)
# - Accessed in code via process.env.PORT
# - Can be overridden by hosting platforms (Heroku, Railway, etc.)
PORT=3000

# HOST: The hostname or IP address for the server to bind to
# - Used by Express.js server.listen() method for network binding
# - Default: localhost (127.0.0.1) for local development
# - Use '0.0.0.0' to bind to all network interfaces for containerization
# - Use specific IP addresses for production network configuration
# - Accessed in code via process.env.HOST
# - IPv6 addresses are supported (e.g., '::1' for localhost)
HOST=localhost

# ----------------------------------------------------------------------------
# Application Environment Configuration
# ----------------------------------------------------------------------------

# NODE_ENV: Node.js environment identifier
# - Standard Node.js convention for environment detection
# - Values: 'development', 'production', 'test'
# - Default: development (enables verbose logging and development features)
# - Used by Express.js and many npm packages for environment-specific behavior
# - Accessed in code via process.env.NODE_ENV
# - Production value enables performance optimizations and security features
# - Test value typically disables logging and enables test-specific configurations
NODE_ENV=development

# ----------------------------------------------------------------------------
# Express.js Framework Configuration
# ----------------------------------------------------------------------------

# EXPRESS_TRUST_PROXY: Configure Express.js trust proxy setting
# - Used for applications behind reverse proxies (nginx, Apache, load balancers)
# - Default: false for direct server access
# - Set to 'true' or specific proxy count for production deployments
# - Affects req.ip, req.hostname, and other request properties
# - Required for proper HTTPS detection behind SSL-terminating proxies
EXPRESS_TRUST_PROXY=false

# ----------------------------------------------------------------------------
# Logging and Debugging Configuration
# ----------------------------------------------------------------------------

# LOG_LEVEL: Application logging verbosity level
# - Controls console output detail for debugging and monitoring
# - Values: 'error', 'warn', 'info', 'debug', 'trace'
# - Default: info (balanced logging for development)
# - Production environments typically use 'warn' or 'error'
# - Debug and trace levels provide extensive debugging information
LOG_LEVEL=info

# DEBUG: Node.js debug module configuration
# - Enables debug output for specific modules or namespaces
# - Format: comma-separated list of debug namespaces
# - Example: 'app:*,express:*' enables all app and express debug output
# - Leave empty to disable debug output (recommended for production)
# - Used by debug package and many Node.js libraries for diagnostic output
DEBUG=

# ----------------------------------------------------------------------------
# Performance and Resource Configuration
# ----------------------------------------------------------------------------

# REQUEST_TIMEOUT: HTTP request timeout in milliseconds
# - Maximum time to wait for request completion
# - Default: 30000ms (30 seconds) - suitable for tutorial application
# - Production APIs may require longer timeouts for complex operations
# - Used to prevent hung connections and resource exhaustion
# - Set to 0 to disable timeout (not recommended)
REQUEST_TIMEOUT=30000

# MAX_REQUEST_SIZE: Maximum HTTP request body size
# - Limits payload size to prevent memory exhaustion attacks
# - Format: size with unit (e.g., '1mb', '500kb', '2gb')
# - Default: 1mb (sufficient for tutorial JSON/text requests)
# - Production APIs may require larger limits for file uploads
# - Used by Express.js body-parser middleware
MAX_REQUEST_SIZE=1mb

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------

# HELMET_ENABLED: Enable Helmet.js security headers middleware
# - Provides protection against common web vulnerabilities
# - Default: true (recommended for all environments)
# - Helmet.js adds security headers like CSP, HSTS, X-Frame-Options
# - Set to false only for development debugging of header issues
# - Essential for production security compliance
HELMET_ENABLED=true

# CORS_ENABLED: Enable Cross-Origin Resource Sharing (CORS)
# - Controls browser cross-origin request permissions
# - Default: true (allows development tools and testing)
# - Production environments should configure specific CORS origins
# - Required for frontend applications on different domains/ports
# - Set to false to disable CORS (same-origin requests only)
CORS_ENABLED=true

# CORS_ORIGIN: Allowed CORS origins
# - Comma-separated list of allowed request origins
# - Default: * (allow all origins - development only)
# - Production should specify exact domains (e.g., 'https://myapp.com')
# - Use localhost with port for local development (e.g., 'http://localhost:3001')
# - Supports wildcards and regex patterns for flexible configuration
CORS_ORIGIN=*

# ----------------------------------------------------------------------------
# Health Check and Monitoring Configuration
# ----------------------------------------------------------------------------

# HEALTH_CHECK_ENABLED: Enable health check endpoint
# - Provides /health endpoint for application monitoring
# - Default: true (recommended for all deployments)
# - Used by load balancers, container orchestration, and monitoring tools
# - Returns application status, uptime, and basic health metrics
# - Kubernetes and Docker Swarm integration for readiness/liveness probes
HEALTH_CHECK_ENABLED=true

# METRICS_ENABLED: Enable application metrics collection
# - Collects performance and usage statistics
# - Default: true (educational value for understanding application behavior)
# - Includes request count, response times, memory usage, error rates
# - Production environments can use for performance monitoring and alerting
# - Minimal overhead for basic metrics collection
METRICS_ENABLED=true

# ----------------------------------------------------------------------------
# Educational and Documentation Settings
# ----------------------------------------------------------------------------

# API_DOCUMENTATION_ENABLED: Enable API documentation endpoint
# - Provides /docs endpoint with application documentation
# - Default: true (educational value for tutorial application)
# - Useful for development and API exploration
# - Production environments may disable for security reasons
# - Includes endpoint descriptions, example requests/responses
API_DOCUMENTATION_ENABLED=true

# VERBOSE_ERRORS: Enable detailed error messages
# - Controls error response verbosity for debugging
# - Default: true (development convenience)
# - Production should set to false to prevent information disclosure
# - Detailed errors include stack traces and internal error details
# - Essential for development debugging and troubleshooting
VERBOSE_ERRORS=true

# ----------------------------------------------------------------------------
# Deployment and Infrastructure Configuration
# ----------------------------------------------------------------------------

# CLUSTER_MODE: Enable Node.js cluster mode
# - Utilizes multiple CPU cores for improved performance
# - Default: false (single process for tutorial simplicity)
# - Production environments can enable for better resource utilization
# - Requires careful consideration of shared state and session management
# - Not recommended for applications with in-memory state
CLUSTER_MODE=false

# GRACEFUL_SHUTDOWN_TIMEOUT: Graceful shutdown timeout in milliseconds
# - Maximum time to wait for connections to close during shutdown
# - Default: 10000ms (10 seconds) - sufficient for tutorial application
# - Production APIs may require longer timeouts for complex cleanup
# - Used for SIGTERM handling and container orchestration
# - Ensures proper resource cleanup and connection termination
GRACEFUL_SHUTDOWN_TIMEOUT=10000

# ----------------------------------------------------------------------------
# Version and Build Information
# ----------------------------------------------------------------------------

# API_VERSION: Application version identifier
# - Used for API versioning and deployment tracking
# - Default: 1.0.0 (semantic versioning format)
# - Should match package.json version for consistency
# - Used in health check responses and logging
# - Essential for deployment monitoring and rollback procedures
API_VERSION=1.0.0

# BUILD_TIMESTAMP: Build timestamp for deployment tracking
# - Set during build process to track deployment versions
# - Format: ISO 8601 timestamp
# - Used for debugging deployment issues and version correlation
# - Automatically populated by CI/CD systems
# - Leave empty for development builds
BUILD_TIMESTAMP=

# ============================================================================
# Environment Variable Loading Instructions
# ============================================================================
#
# This file is loaded by the dotenv package at application startup.
# To use these variables in your Node.js application:
#
# 1. Install dotenv: npm install dotenv@16.4.5
# 2. Load in your main file: require('dotenv').config()
# 3. Access variables: process.env.PORT
#
# Example usage in server.js:
# ```javascript
# require('dotenv').config();
# const port = process.env.PORT || 3000;
# const host = process.env.HOST || 'localhost';
# ```
#
# For production deployments:
# - Use environment-specific .env files (.env.production, .env.staging)
# - Override values using system environment variables
# - Use secure secret management for sensitive values
# - Never commit .env files with production secrets to version control
#
# Validation recommendations:
# - Validate required environment variables at startup
# - Provide sensible defaults for optional variables
# - Use type conversion for numeric values (parseInt, parseFloat)
# - Implement environment variable schema validation
#
# ============================================================================