{
  "name": "nodejs-tutorial-backend",
  "version": "1.0.0",
  "description": "Node.js tutorial application demonstrating a simple Express.js HTTP server with a /hello endpoint.",
  "main": "server.js",
  "type": "module",
  "author": "Node.js Tutorial Authors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/backend"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.0.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.1.1",
    "typescript": "^5.4.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 100,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:node/recommended",
      "plugin:promise/recommended",
      "plugin:import/recommended",
      "prettier"
    ],
    "plugins": ["node", "promise", "import"],
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "node/no-missing-import": "off",
      "node/no-unpublished-require": "off"
    }
  },
  "nodemonConfig": {
    "watch": ["src/backend"],
    "ext": "js,json",
    "ignore": ["node_modules", "coverage", "*.test.js"],
    "exec": "node server.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "tutorial",
    "backend",
    "http-server",
    "javascript",
    "rest-api",
    "web-development",
    "educational"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nodejs-tutorial/backend.git"
  },
  "bugs": {
    "url": "https://github.com/nodejs-tutorial/backend/issues"
  },
  "homepage": "https://github.com/nodejs-tutorial/backend#readme"
}